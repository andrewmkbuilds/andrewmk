// Shared Cloudflare settings for this Nitro build.
//
// Nitro reads this file and merges it into its own generated deploy config:
// `.output/server/wrangler.json` for the Workers bundle (`bun run build`) and
// `dist/_worker.js/wrangler.json` for the Pages bundle Cloudflare's builder
// produces. Nitro adds the target-specific fields itself — the Worker entry
// point, the assets binding and its directory for Workers, and
// `pages_build_output_dir` for Pages — so only the shared settings belong here.
//
// Do NOT put `main` or an `assets` binding back: Cloudflare Pages reserves the
// `ASSETS` binding name and has no Worker entry point, and the merged Pages
// config is rejected with "The name 'ASSETS' is reserved in Pages projects"
// (the failing Pages deployment of 2026-11-02).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "andrewmkbuilds-andrewmk",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
}
